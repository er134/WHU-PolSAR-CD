# ================================
# WHU-PolSAR-CD .gitignore
# ================================

# 🐍 Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# 📊 Jupyter & IPython
.ipynb_checkpoints/
*.ipynb
!README.ipynb  # 如果保留说明性notebook可取消注释
*.pkl
*.pickle

# 🗄️ Large Data Files (建议用 Git LFS 或外部链接)
*.npy
*.npz
*.h5
*.hdf5
*.mat
*.zip
*.tar
*.tar.gz
*.rar
*.7z
data/raw/
data/processed/
!data/.gitkeep  # 保留空目录结构

# 🤖 Model Weights & Checkpoints
*.pth
*.pt
*.ckpt
*.onnx
*.pb
saved_models/
checkpoints/
runs/
tensorboard_logs/

# 📈 Generated Stats & Cache
mean.npy
std.npy
stats/
cache/
.tmp/
*.log

# 🔧 IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pyproject
.DS_Store
Thumbs.db

# 🌐 Environment & Secrets
.env
.env.local
*.key
*.pem
credentials.json
secrets/

# 📦 Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# 🧪 Test & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# 📝 Documentation Build
docs/_build/
*.pdf
*.aux
*.toc

# 🗑️ Temporary & OS Files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~